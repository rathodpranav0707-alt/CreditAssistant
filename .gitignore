# ============================================================
#  Credit Assistant — .gitignore
#  Covers: Node.js, React/Vite, Python, FastAPI, SQLite, OS
# ============================================================

# ──────────────────────────────────────
#  Node.js / npm
# ──────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json.bak

# ──────────────────────────────────────
#  React / Vite build output
# ──────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# ──────────────────────────────────────
#  Python
# ──────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# ──────────────────────────────────────
#  Python virtual environments
# ──────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
backend/venv/
backend/.venv/

# ──────────────────────────────────────
#  Environment files  ← NEVER commit .env
# ──────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ──────────────────────────────────────
#  SQLite / local database files
# ──────────────────────────────────────
*.db
*.sqlite
*.sqlite3
backend/credit_assistant.db

# ──────────────────────────────────────
#  Python packaging / eggs
# ──────────────────────────────────────
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
wheels/

# ──────────────────────────────────────
#  Testing & coverage
# ──────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ──────────────────────────────────────
#  Logs
# ──────────────────────────────────────
logs/
*.log

# ──────────────────────────────────────
#  IDE & editor files
# ──────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────
#  OS / system files
# ──────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ──────────────────────────────────────
#  Miscellaneous
# ──────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
