# Credit Assistant — Backend Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file to version control.

# A long, random string used to sign application tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_key_in_production

# SQLAlchemy database URL.
# Default uses SQLite (created automatically on first run).
# To use PostgreSQL: postgresql://user:password@localhost/credit_assistant
DATABASE_URL=sqlite:///./credit_assistant.db

# The origin where your frontend is running (used for CORS).
FRONTEND_ORIGIN=http://localhost:5173

# Google Gemini API key — obtain from https://aistudio.google.com/
# The application works without this key (falls back to educational recommendations).
GEMINI_API_KEY=your_gemini_api_key_here
